{
  "name": "angel-dreamer-nuxt-store",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node --env-file=.env .output/server/index.mjs",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/fix-coverage-links.mjs coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/extension-unique-id": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/vue-3": "^3.30.2",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.10",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.1.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "stripe": "^22.5.0",
    "vue": "^3.5.18",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
