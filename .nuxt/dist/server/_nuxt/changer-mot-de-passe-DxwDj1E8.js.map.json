{"file":"changer-mot-de-passe-DxwDj1E8.js","mappings":";;;;;;;;;;;;;;;;;;;;;;AAGA,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,EAAC,KAAA,KAAQ,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAA2D;AAAA,MAAA;AAAA;AAAA,IAAA,CAAc,GAAA,SAAA,MAAA,QAAA,UAAA,GAAA;AAC9F,QAAI,CAAC,KAAK,OAAO,KAAM,EAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,WAAW,2CAA2C,CAAA,GAAA,MAAA,QAAA,UAAA;;;;;2BAsBlEC,eAAAC,MAAA,MAAA,EAAO,QAAQ,mBACZD,eAAAC,MAAA,MAAA,EAAO,QAAQ,CAAA,oMAAAC,cAAA,SAGgBD,MAAA,QAAA,CAAQ,CAAA,qJAAAC,cAAA,SAE5BD,MAAA,YAAA,CAAY,sHAEVA,MAAA,OAAA,IAAO,oBAAA,8BAAA,CAAA,WAAA;AACpB,UAAAA,MAAA,KAAA,GAAK;sCAAKA,MAAA,KAAA,CAAK,CAAA,SAAA;AAAA,MAAA,OAAA;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderClass","_unref","_ssrRenderAttr"],"sources":["../../../../pages/changer-mot-de-passe.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport styles from '~/assets/css/site.module.css';\n\nconst password = ref('');\nconst confirmation = ref('');\nconst error = ref('');\nconst loading = ref(false);\nconst {data} = await useFetch<{ user: { mustChangePassword: boolean } | null }>('/api/auth/me');\nif (!data.value?.user) await navigateTo('/connexion?returnTo=/changer-mot-de-passe');\n\nasync function submit() {\n  error.value = '';\n  if (password.value !== confirmation.value) {\n    error.value = 'Les mots de passe ne correspondent pas';\n    return\n  }\n  loading.value = true;\n  try {\n    await $fetch('/api/auth/change-password', {method: 'POST', body: {password: password.value}});\n    await navigateTo('/admin', {external: true})\n  } catch (e: any) {\n    error.value = e?.data?.statusMessage || 'Modification impossible'\n  } finally {\n    loading.value = false\n  }\n}\n</script>\n<template>\n  <main>\n    <StoreHeader/>\n    <div :class=\"styles.authPage\">\n      <form :class=\"styles.authCard\" @submit.prevent=\"submit\"><small>SÉCURITÉ</small>\n        <h1>Nouveau mot de passe</h1>\n        <p>Pour protéger l’administration, vous devez remplacer le mot de passe temporaire avant de continuer.</p>\n        <label>Nouveau mot de passe<input v-model=\"password\" type=\"password\" autocomplete=\"new-password\" minlength=\"12\"\n                                          required><em>12 caractères minimum.</em></label><label>Confirmer le mot de\n          passe<input v-model=\"confirmation\" type=\"password\" autocomplete=\"new-password\" minlength=\"12\"\n                      required></label>\n        <button type=\"submit\">{{ loading ? 'Enregistrement…' : 'Enregistrer mon mot de passe' }}</button>\n        <span v-if=\"error\">{{ error }}</span></form>\n    </div>\n  </main>\n</template>\n"],"version":3}