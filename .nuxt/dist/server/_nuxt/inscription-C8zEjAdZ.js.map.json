{"file":"inscription-C8zEjAdZ.js","mappings":";;;;;;;;;;;;;;;;;;;;;AAGc,aAAA;AACd,UAAM,YAAY,IAAI,EAAE;AACxB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,kBAAkB,IAAI,EAAE;AAC9B,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,UAAU,IAAI,KAAK;;;;;;AAyBR,YAAA,eAAAA,eAAAC,MAAA,MAAA,EAAO,QAAQ,mBACZD,eAAAC,MAAA,MAAA,EAAO,QAAQ,CAAA,yKAAAC,cAAA,SAGdD,MAAA,SAAA,CAAS,kHACTA,MAAA,QAAA,CAAQ,CAAA,8FAAAC,cAAA,SAC6BD,MAAA,KAAA,CAAK,CAAA,gFAAAC,cAAA,SACsCD,MAAA,QAAA,CAAQ,CAAA,oJAAAC,cAAA,SAK/BD,MAAA,eAAA,CAAe,CAAA,sGAAAE,eAG5DF,MAAA,OAAA,IAAO,cAAA,kBAAA,CAAA,WAAA;AACpB,UAAAA,MAAA,KAAA,GAAK;sCAAKA,MAAA,KAAA,CAAK,CAAA,SAAA;AAAA,MAAA,OAAA;;;;AAEf,YAAAG,mBAAA,qBAAA,EAAA,IAAG,gBAAY;AAAA,QAAA,SAAAC,QAAzB,CAAiD,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAAvB,cAAY;AAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderClass","_unref","_ssrRenderAttr","_ssrInterpolate","_ssrRenderComponent","_withCtx","_push","_parent"],"sources":["../../../../pages/inscription.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport styles from '~/assets/css/site.module.css';\n\nconst route = useRoute();\nconst firstName = ref('');\nconst lastName = ref('');\nconst email = ref('');\nconst password = ref('');\nconst confirmPassword = ref('');\nconst error = ref('');\nconst loading = ref(false);\n\nasync function submit() {\n  if (password.value !== confirmPassword.value) {\n    error.value = 'Les mots de passe ne correspondent pas';\n    return\n  }\n  loading.value = true;\n  error.value = '';\n  try {\n    await $fetch('/api/auth/register', {\n      method: 'POST',\n      body: {firstName: firstName.value, lastName: lastName.value, email: email.value, password: password.value}\n    });\n    const target = typeof route.query.returnTo === 'string' && route.query.returnTo.startsWith('/') && !route.query.returnTo.startsWith('//') ? route.query.returnTo : '/compte';\n    await navigateTo(target, {external: true})\n  } catch (e: any) {\n    error.value = e?.data?.statusMessage || 'Inscription impossible'\n  } finally {\n    loading.value = false\n  }\n}</script>\n<template>\n  <main>\n    <StoreHeader/>\n    <div :class=\"styles.authPage\">\n      <form :class=\"styles.authCard\" @submit.prevent=\"submit\"><small>NOUVEAU COMPTE</small>\n        <h1>Créer un compte</h1>\n        <p>Ces informations servent uniquement à votre compte et au traitement de vos commandes.</p><label>Prénom<input\n            v-model=\"firstName\" type=\"text\" autocomplete=\"given-name\" maxlength=\"80\" required></label><label>Nom<input\n            v-model=\"lastName\" type=\"text\" autocomplete=\"family-name\" maxlength=\"80\"\n            required></label><label>E-mail<input v-model=\"email\" type=\"email\" autocomplete=\"email\"\n                                                 required></label><label>Mot de passe<input v-model=\"password\"\n                                                                                            type=\"password\"\n                                                                                            minlength=\"10\"\n                                                                                            autocomplete=\"new-password\"\n                                                                                            required><em>10 caractères\n          minimum</em></label><label>Confirmer le mot de passe<input v-model=\"confirmPassword\" type=\"password\"\n                                                                     minlength=\"10\" autocomplete=\"new-password\"\n                                                                     required></label>\n        <button type=\"submit\">{{ loading ? 'Création…' : 'Créer mon compte' }}</button>\n        <span v-if=\"error\">{{ error }}</span>\n        <p>Déjà inscrit ?\n          <NuxtLink to=\"/connexion\">Se connecter</NuxtLink>\n        </p>\n      </form>\n    </div>\n  </main>\n</template>\n"],"version":3}